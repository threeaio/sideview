{
  "name": "sideview",
  "version": "0.1.0-alpha.1",
  "productName": "Sideview",
  "type": "module",
  "description": "A canvas next to your Claude Code thread: put screenshots on it, frame spots, speak or type notes, and send them back to Claude.",
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\" \"extensions/*/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json",
    "mcp": "node src/mcp/server.ts",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "app": "electron src/electron/main.ts",
    "app:dev": "CANVAS_RENDERER_URL=http://localhost:4721 electron src/electron/main.ts",
    "prepare": "vite build",
    "check:english": "npm run build:renderer && node scripts/check-english.mjs",
    "check:labels": "npm run build:renderer && node scripts/check-labels.mjs",
    "check:scrim": "npm run build:renderer && node scripts/check-scrim.mjs",
    "check:open": "npm run build:renderer && node scripts/check-open.mjs",
    "check:compare": "npm run build:renderer && node scripts/check-compare.mjs",
    "check:voice-ui": "npm run build:renderer && node scripts/check-voice-ui.mjs",
    "check:npx": "node scripts/check-npx.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tanstack/react-query": "5.105.3",
    "@typesafe-ai/sdk": "^0.7.0",
    "electron": "45.2.2",
    "image-size": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "src/electron/main.ts",
  "license": "SEE LICENSE IN LICENSE",
  "bin": {
    "sideview": "bin/sideview.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "config/",
    "dist/renderer/",
    "assets/icon.png",
    "assets/icon.icns",
    "assets/icon.svg",
    "extensions/README.md",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin"
  ],
  "repository": "github:threeaio/sideview",
  "author": "Nikolaj Sokolowski"
}
